    {
      "id": 12,
      "type": "table",
      "title": "Estado de las señales",
      "datasource": {
        "type": "prometheus",
        "uid": "tsst-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tsst-prom"
          },
          "expr": "max by (channel, name) (tsst_input_signal)",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tsst-prom"
          },
          "expr": "max by (channel, name) (tsst_input_bitrate_bits_per_second)",
          "legendFormat": "__auto",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tsst-prom"
          },
          "expr": "max by (channel, name) (tsst_input_restarts_total)",
          "legendFormat": "__auto",
          "refId": "F",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "channel": 0,
              "name": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #F": 4
            },
            "renameByName": {
              "channel": "Canal",
              "name": "Señal",
              "Value #A": "Señal OK",
              "Value #B": "Bitrate",
              "Value #F": "Reconexiones"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Señal OK"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "SIN SEÑAL",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "OK",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Bitrate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Canal",
            "desc": false
          }
        ]
      }
    },
