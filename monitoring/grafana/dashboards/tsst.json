{
  "uid": "tsst-rtsp-srt",
  "title": "TSST · Servidor RTSP → SRT",
  "tags": [
    "tsst",
    "srt"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
